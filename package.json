{
  "name": "otyapoint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:local:check": "node scripts/check-local-development.mjs",
    "test:local-auth": "node --test cloudflare-api/dev-auth/index.test.mjs",
    "test:local-runtime": "bash scripts/verify-local-development.sh",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "check:worker": "tsc --noEmit -p cloudflare-api/tsconfig.json",
    "test:sale-fingerprint": "node --test cloudflare-api/tests/sale-fingerprint.test.mjs",
    "test:sale-route-idempotency": "node --test cloudflare-api/tests/sale-route-idempotency.test.mjs",
    "test:auth-boundary": "node --test cloudflare-api/tests/auth-boundary.test.mjs",
    "test:agency-list": "node --test cloudflare-api/tests/agency-list.test.mjs cloudflare-api/tests/agency-readiness.test.mjs",
    "test:agency-readiness": "node --test cloudflare-api/tests/agency-readiness.test.mjs",
    "test:legacy-products-bridge": "node --test tests/legacy-products-bridge.test.mjs",
    "test:quickteller": "node --test cloudflare-api/tests/quickteller-business-sandbox.test.mjs cloudflare-api/tests/quickteller-auth-route.test.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "0.468.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.119.0",
    "vinext": "1.4.6",
    "react-server-dom-webpack": "19.3.1",
    "@vinext/cloudflare": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "cf": "1.0.0-rc.1"
  },
  "type": "module"
}
